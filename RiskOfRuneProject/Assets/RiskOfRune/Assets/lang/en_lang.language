        "RISKOFRUNE_ITEM_GUIDEBOOK_DESCSCRIPTION": "All drones can now additionally cast a heal prayer," +
			"\nhealing for <style=cIsHealing>2.5%</style> hp every <style=cIsUtility>10</style> seconds. <style=cStack>(+1% hp per stack)</style>",
        "RISKOFRUNE_ITEM_GUIDEBOOK_LORE": "You tried to read the handcrafted manual, but it was so dense it made your head spin..." +
            "\nPerhaps just the chapter on healing will be good for now...",
			
			
			
		"RISKOFRUNE_ITEM_BIGSHOT_NAME": "Dealmaker",
        "RISKOFRUNE_ITEM_BIGSHOT_PICKUP": "Gain stacks of <style=cDeath>[Big Shot]</style> on gold gain.",
        "RISKOFRUNE_ITEM_BIGSHOT_DESCSCRIPTION": "<style=cShrine>+30%</style> gold gain.\nOn gold gain, gain <style=cStack>1</style> stack of <style=cDeath>[Big Shot]</style>.\n" +
            "On <style=cIsUtility>10</style> stacks, shoot a projectile on primary skill dealing <style=cIsDamage>777%</style> dmg. <style=cStack>(+222% per stack)</style>",
        "RISKOFRUNE_ITEM_BIGSHOT_LORE": "As the days became more dull, and bussiness started to dry, a call came in." +
            "\nIt's your chance... a once in a lifetime chance... to become a <style=cDeath>[Big Shot]</style>.",
			
		"RISKOFRUNE_ITEM_ROARINGBLADE_NAME": "Roaring Blade",
        "RISKOFRUNE_ITEM_ROARINGBLADE_PICKUP": "Stack swoon on hit, total damage dealt prior reapplies after 3 stacks.",
        "RISKOFRUNE_ITEM_ROARINGBLADE_DESCSCRIPTION": "<style=cIsDamage>50%</style> chance to apply Swoon. Upon reaching " +
            "<style=cIsUtility>3</style> stacks, reapply <style=cIsDamage>200%</style> of all damage dealt back to enemy. <style=cStack>(+100% per stack)</style>",
        "RISKOFRUNE_ITEM_ROARINGBLADE_LORE": "You pick up the strange, cold blade..." +
            "\nShivers crawl down your spine as you lift it into the air." +
            "\nA strange feeling emerges from it, you can feel it speaking... crying... hurting..." +
            "\nYou respond to its call, its <style=cMono><style=cDeath>anger</style></style>, you move forward, gripping the blade tightly, changed ever so slightly.",
			
		"RISKOFRUNE_ITEM_SCRAPBALL_NAME": "Junk Ball",
        "RISKOFRUNE_ITEM_SCRAPBALL_PICKUP": "Gain a boost to damage and attack speed for each consumed item you own.",
        "RISKOFRUNE_ITEM_SCRAPBALL_DESCSCRIPTION": "Gain a 5% boost to damage and attack speed for each consumed item you own. <style=cStack>(+5% per stack)</style>",
        "RISKOFRUNE_ITEM_SCRAPBALL_LORE": "You reach into your pocket and find a small ball full of accumulated things in your pocket.\n" +
            "\nYou look at the ball of junk in admiration of the useless itmes you've accumulated... Nothing happened.",
			
		
		
		"RISKOFRUNE_ITEM_DEVILSKNIFE_NAME": "Devilsknife",
        "RISKOFRUNE_ITEM_DEVILSKNIFE_PICKUP": "Gain a random effect every 10 seconds for 10 seconds...",
        "RISKOFRUNE_ITEM_DEVILSKNIFE_DESCSCRIPTION": "Grants <style=cIsUtility>WORLD REVOLVING</style> every 10 seconds.\n" +
            "<style=cIsUtility>WORLD REVOLVING</style>: Gain a random effect every 10 seconds.\nRandom effect duration increased by <style=cStack>+5 seconds per stack</style>.",
        "RISKOFRUNE_ITEM_DEVILSKNIFE_LORE": "You hear incomprehensible laughter and the world starts to spin.\nYou crave...  <style=cMono><style=cDeath>CHAOS</style></style>.",
		
		"RISKOFRUNE_ITEM_THORNRING_NAME": "Ring of Regret",
        "RISKOFRUNE_ITEM_THORNRING_PICKUP": "Receive <style=cDeath>pain</style> to become <style=cIsUtility><style=cMono>stronger</style></style>.",
        "RISKOFRUNE_ITEM_THORNRING_DESCSCRIPTION": "Apply <style=cIsUtility>1</style> stack of <style=cIsUtility>frostbite on hit. </style><style=cStack>(+1 per stack)</style>" +
            "\nStacks of frostbite cause enemies to <style=cIsUtility>freeze</style>.\nLose <style=cIsHealth>30% hp.</style> <style=cStack>(10% hp per stack)</style>",
