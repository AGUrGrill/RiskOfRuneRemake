		"RISKOFRUNE_ITEM_GRANDPRIZE_NAME": "Grand Prize",
        "RISKOFRUNE_ITEM_GRANDPRIZE_PICKUP": "Gain a temporary gacha pull on stage start.",
        "RISKOFRUNE_ITEM_GRANDPRIZE_DESCSCRIPTION": "Gain a random item from the gacha item pool on stage start <style=cStack>(+1 item per stack)</style>.",
